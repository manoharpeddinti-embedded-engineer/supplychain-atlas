# Copy to .env. Never commit credentials.
SNOWFLAKE_ACCOUNT=your_organization-account
SNOWFLAKE_USER=your_user
# Recommended local development sign-in. This opens your existing Snowflake sign-in flow.
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=SUPPLYCHAIN_HACK_WH
SNOWFLAKE_DATABASE=SUPPLYCHAIN_ATLAS
SNOWFLAKE_SCHEMA=CORE
